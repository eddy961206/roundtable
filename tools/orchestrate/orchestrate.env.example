# Copy to local/orchestrate.env (gitignored) or point ORCH_ENV at your copy.
# Sourced by env.sh with bash; environment variables set before running win.
# No tokens here: tea and git use their stored logins.

# Gitea repository the PRs and comments go to (owner/name).
ORCH_REPO=owner/repo
# Login asked to review new PRs (gpost.sh pr) and watched by reviewer_check.py.
ORCH_REVIEWER=reviewer-login
# Extra repositories reviewer_check.py watches (comma separated). Default: ORCH_REPO.
#ORCH_WATCH_REPOS=owner/repo,owner/older-repo
# Base branch for PRs and rebases.
#ORCH_BASE=main
# Parent folder holding the writer worktrees (queue_review.sh <name>).
ORCH_WORKTREES=$HOME/worktrees
# Prompt files (start from templates/).
ORCH_WRITER_RULES=$ORCH_DIR/local/writer-rules.md
ORCH_REVIEW_TEMPLATE=$ORCH_DIR/local/review-template.md
# Optional: resolves rebase conflicts in queue_review.sh; gets the conflicted files.
#ORCH_CONFLICT_HOOK=$ORCH_DIR/local/conflict_hook.sh
# Optional: CI status context substring for ci_wait.sh (empty = combined state).
#ORCH_CI_CONTEXT=linux
# Optional: one more regex glint.py treats as a local path (e.g. a worktree prefix).
#ORCH_LINT_EXTRA=_worktrees[\\/]
# Local clone pr_overlap.py / after_merge.py read (PR heads are fetched into refs/orch/*),
# and where worktree_claims.py --branch looks up the branch's worktree.
ORCH_REPO_DIR=$HOME/src/repo
#ORCH_REMOTE=origin
# Branch → writer room (and optional worktree) for after_merge.py --assign and the
# occupancy check: {"feat/x": {"room": "<room id>", "worktree": "<dir>"}, "feat/y": "<room id>"}
#ORCH_BRANCH_ROOMS=$ORCH_DIR/local/branch_rooms.json
# Worktree claims (worktree_claims.py claim/release).
#ORCH_CLAIMS=$HOME/.rt-orchestrate/claims.json
# Schema number pattern (group 1 = number) and the --integrate test command.
# Quote values with spaces; single quotes keep backslashes.
#ORCH_SCHEMA_REGEX='const schemaVersion = (\d+)'
#ORCH_INTEGRATE_TEST='go test ./...'
#ORCH_REBASE_TEMPLATE=$ORCH_DIR/templates/rebase-notice.md
# Tools and server (defaults shown).
#ORCH_TEA=tea
#ORCH_RT_BIN=roundtable
#ORCH_RT_URL=http://127.0.0.1:18787
#ORCH_STATE=$HOME/.rt-orchestrate
